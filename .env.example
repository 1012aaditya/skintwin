# SkinTwin configuration. Copy to `.env` (project root in development, or
# ~/Library/Application Support/SkinTwin/.env for the packaged app).
# Every key is optional — SkinTwin runs without any of them and explains what's missing.
# Keys are read only by the Electron main process and never reach the UI.

# --- Assistant (language model) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# SKINTWIN_LLM_MODEL=claude-opus-5-5

# --- Skin analysis — YouCam API key from https://yce.makeupar.com/api-console/en/api-keys/
YOUCAM_API_KEY=
# YOUCAM_API_BASE=https://yce-api-01.makeupar.com

# --- Speech-to-text (pick one; OpenAI is preferred when both are set)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# STT_PROVIDER=openai        # or: elevenlabs

# --- Text-to-speech. Default "system" = on-device macOS voice (free, no key).
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_VOICE_ID=

# --- Development switches (default ON in `npm run dev`, OFF in packaged builds)
# SKINTWIN_DEMO_CATALOG=1    # seed the clearly-labelled demo product catalog
# SKINTWIN_ENABLE_MOCKS=1    # allow a labelled mock skin analysis when no YouCam key is set
# SKINTWIN_BRIDGE_PORT=47821 # browser-extension bridge (also change extension/manifest.json + popup.js)
