{
  "name": "skintwin",
  "productName": "SkinTwin",
  "version": "0.1.0",
  "description": "SkinTwin \u2014 personal AI skincare companion (desktop app + floating companion + browser extension)",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "package:mac": "electron-vite build && electron-builder --mac --dir",
    "extension:zip": "cd extension && zip -r ../dist/skintwin-extension.zip . -x '*.DS_Store'",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "shots:companion": "electron-vite build && node scripts/companion-shots.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "app.skintwin.desktop",
    "productName": "SkinTwin",
    "directories": {
      "output": "dist/app"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "SkinTwin listens only while the companion shows it is listening, so you can ask questions out loud.",
        "NSCameraUsageDescription": "SkinTwin uses the camera only when you choose to take a selfie for skin analysis."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
